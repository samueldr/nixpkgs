			dtb = "allwinner/sun50i-a64-pinebook.dtb";
			model = "Pinebook";
			compatible = "pine64,pinebook";
		};
		/* Pine64 PinePhone Developer Batch (1.0): ["pine64,pinephone-1.0", "pine64,pinephone", "allwinner,sun50i-a64"] */
