/*
 * actions
 */
/ {
	mapping {
		/* CubieBoard7: ["cubietech,cubieboard7", "actions,s700"] */
		actions@s700-cubieboard7 {
			dtb = "actions/s700-cubieboard7.dtb";
			model = "CubieBoard7";
			compatible = "cubietech,cubieboard7";
		};
		/* Bubblegum-96: ["ucrobotics,bubblegum-96", "actions,s900"] */
		actions@s900-bubblegum-96 {
			dtb = "actions/s900-bubblegum-96.dtb";
			model = "Bubblegum-96";
			compatible = "ucrobotics,bubblegum-96";
		};
	};
};

/*
 * allwinner
 */
/ {
	mapping {
		/* Allwinner A100 Perf1: ["allwinner,a100-perf1", "allwinner,sun50i-a100"] */
		allwinner@sun50i-a100-allwinner-perf1 {
			dtb = "allwinner/sun50i-a100-allwinner-perf1.dtb";
			model = "Allwinner A100 Perf1";
			compatible = "allwinner,a100-perf1";
		};
		/* Amarula A64-Relic: ["amarula,a64-relic", "allwinner,sun50i-a64"] */
		allwinner@sun50i-a64-amarula-relic {
			dtb = "allwinner/sun50i-a64-amarula-relic.dtb";
			model = "Amarula A64-Relic";
			compatible = "amarula,a64-relic";
		};
		/* BananaPi-M64: ["sinovoip,bananapi-m64", "allwinner,sun50i-a64"] */
		allwinner@sun50i-a64-bananapi-m64 {
			dtb = "allwinner/sun50i-a64-bananapi-m64.dtb";
			model = "BananaPi-M64";
			compatible = "sinovoip,bananapi-m64";
		};
		/* FriendlyARM NanoPi A64: ["friendlyarm,nanopi-a64", "allwinner,sun50i-a64"] */
		allwinner@sun50i-a64-nanopi-a64 {
			dtb = "allwinner/sun50i-a64-nanopi-a64.dtb";
			model = "FriendlyARM NanoPi A64";
			compatible = "friendlyarm,nanopi-a64";
		};
		/* Oceanic 5205 5inMFD: ["oceanic,5205-5inmfd", "allwinner,sun50i-a64"] */
		allwinner@sun50i-a64-oceanic-5205-5inmfd {
			dtb = "allwinner/sun50i-a64-oceanic-5205-5inmfd.dtb";
			model = "Oceanic 5205 5inMFD";
			compatible = "oceanic,5205-5inmfd";
		};
		/* Olimex A64-Olinuxino-eMMC: ["olimex,a64-olinuxino-emmc", "allwinner,sun50i-a64"] */
		allwinner@sun50i-a64-olinuxino-emmc {
			dtb = "allwinner/sun50i-a64-olinuxino-emmc.dtb";
			model = "Olimex A64-Olinuxino-eMMC";
			compatible = "olimex,a64-olinuxino-emmc";
		};
		/* Olimex A64-Olinuxino: ["olimex,a64-olinuxino", "allwinner,sun50i-a64"] */
		allwinner@sun50i-a64-olinuxino {
			dtb = "allwinner/sun50i-a64-olinuxino.dtb";
			model = "Olimex A64-Olinuxino";
			compatible = "olimex,a64-olinuxino";
		};
		/* OrangePi Win/Win Plus: ["xunlong,orangepi-win", "allwinner,sun50i-a64"] */
		allwinner@sun50i-a64-orangepi-win {
			dtb = "allwinner/sun50i-a64-orangepi-win.dtb";
			model = "OrangePi Win/Win Plus";
			compatible = "xunlong,orangepi-win";
		};
		/* Pine64 LTS: ["pine64,pine64-lts", "allwinner,sun50i-r18", "allwinner,sun50i-a64"] */
		allwinner@sun50i-a64-pine64-lts {
			dtb = "allwinner/sun50i-a64-pine64-lts.dtb";
			model = "Pine64 LTS";
			compatible = "pine64,pine64-lts";
		};
		/* Pine64+: ["pine64,pine64-plus", "allwinner,sun50i-a64"] */
		allwinner@sun50i-a64-pine64-plus {
			dtb = "allwinner/sun50i-a64-pine64-plus.dtb";
			model = "Pine64+";
			compatible = "pine64,pine64-plus";
		};
		/* Pine64: ["pine64,pine64", "allwinner,sun50i-a64"] */
		allwinner@sun50i-a64-pine64 {
			dtb = "allwinner/sun50i-a64-pine64.dtb";
			model = "Pine64";
			compatible = "pine64,pine64";
		};
